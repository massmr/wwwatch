# Anthropic (pipeline generation)
ANTHROPIC_API_KEY=sk-ant-...

# Neon (server-only, never NEXT_PUBLIC_)
DATABASE_URL=postgres://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Resend — domain wwwatch.dev must be validated in Resend dashboard
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=brief@wwwatch.dev    # weekly newsletter
RESEND_FROM_WELCOME=hello@wwwatch.dev  # onboarding / welcome email

# Unsubscribe HMAC secret — generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=change-me-32-chars-minimum

# Public site URL (non-sensitive, used for unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://wwwatch.dev

# Vercel deploy hook — triggers a rebuild when an edition is published so
# 'use cache' pages reflect the new content. Create in Vercel dashboard:
# Project → Settings → Git → Deploy Hooks. Configure in Phase 6.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# GitHub mirror — fine-grained PAT, wwwatch-journal repo only, Contents R/W
# Create at: Settings → Developer settings → Fine-grained tokens
# Permissions: Contents Read & write on the mirror repo only.
GITHUB_MIRROR_TOKEN=github_pat_...
GITHUB_MIRROR_REPO=org/wwwatch-journal

# IndexNow — submit published URLs to Bing/Yandex on each publish.
# The key file public/{key}.txt must match this value exactly.
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=change-me-32-hex-chars

# PostHog analytics — public ingestion key, safe to expose to the browser.
# Create a project at posthog.com — choose EU region (non-modifiable after creation).
# NEXT_PUBLIC_ is intentional here: project token is not a secret (see PLAN_6 §6 rule 1).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
